# Docker General settings
SIP_VERSION=2.0.0
SIP_IMAGE=nexus.eigen.livesip

DAGSTER_HOME=/opt/dagster/sip
# You really don't want to change this.

# Postgres configuration
DAGSTER_POSTGRES_HOST=postgres-sip
DAGSTER_POSTGRES_PORT=5432
DAGSTER_POSTGRES_USER=dagster
DAGSTER_POSTGRES_PASSWORD=myswankydagsterpassword
DAGSTER_POSTGRES_NAME=dagster

# Dagster Webserver
DAGSTER_WEBSERVER_PORT=3001

# Redis Configuration 
DAGSTER_REDIS_HOST=redis-sip
DAGSTER_REDIS_PORT=6379
DAGSTER_REDIS_DB=8

# Rabbitmq + Celery Configuration 
DAGSTER_RABBITMQ_HOST=rabbitmq-sip
DAGSTER_RABBITMQ_USERNAME=sip 
DAGSTER_RABBITMQ_PASSWORD=sipwithconcurrencyisprettysweet
DAGSTER_RABBITMQ_VHOST=dagster-broker

# AWS 
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Eigen resource 
EIGEN_DOMAIN=172.16.32.1
EIGEN_USERNAME=
EIGEN_PASSWORD=

# Azure Queue Resource
AZURE_QUEUE_NAMESPACE=
AZURE_QUEUE_NAME=
AZURE_QUEUE_CONSUMER_NAME=
AZURE_QUEUE_ACCESS_KEY_CODE=

# GraphQL resource 
GRAPHQL_DOMAIN=

# Hayashi resource
HAYASHI_DOMAIN=localhost 
HAYASHI_USERNAME=
HAYASHI_PASSWORD=

# S3 resource 
S3_ROOT_BUCKET_NAME=
S3_DEFAULT_PREFIX=
S3_MINIO_URL=

# Sharepoint Resource 
SHAREPOINT_API_BASE="graph.microsoft.com/v1.0"
SHAREPOINT_DOMAIN=
SHAREPOINT_SITE_ID=
SHAREPOINT_TENANT_ID=
SHAREPOINT_CLIENT_ID=
SHAREPOINT_CLIENT_SECRET=
SHAREPOINT_SITE_BASE=""

