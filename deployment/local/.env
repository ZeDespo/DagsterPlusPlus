# Docker General settings
DOCKER_VERSION=1.2.1
DOCKER_IMAGE=

# Postgres configuration
export DAGSTER_POSTGRES_HOST=0.0.0.0
export DAGSTER_POSTGRES_PORT=5432
export DAGSTER_POSTGRES_USER=dagster
export DAGSTER_POSTGRES_PASSWORD=myswankydagsterpassword
export DAGSTER_POSTGRES_NAME=dagster

# Dagster Webserver
export DAGSTER_WEBSERVER_PORT=3001

# Redis Configuration 
export DAGSTER_REDIS_HOST=0.0.0.0
export DAGSTER_REDIS_PORT=6379
export DAGSTER_REDIS_DB=8

# Rabbitmq + Celery Configuration 
export DAGSTER_RABBITMQ_HOST=0.0.0.0
export DAGSTER_RABBITMQ_USERNAME=dagplusplus 
export DAGSTER_RABBITMQ_PASSWORD=dagwithconcurrencyisprettysweet
export DAGSTER_RABBITMQ_VHOST=dagster-broker

# AWS 
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# S3 resource 
S3_ROOT_BUCKET_NAME=
S3_DEFAULT_PREFIX=
S3_MINIO_URL=

# Sharepoint Resource 
SHAREPOINT_API_BASE="graph.microsoft.com/v1.0"
SHAREPOINT_DOMAIN=
SHAREPOINT_SITE_ID=
SHAREPOINT_TENANT_ID=
SHAREPOINT_CLIENT_ID=
SHAREPOINT_CLIENT_SECRET=
