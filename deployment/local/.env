export DAGSTER_POSTGRES_HOST=0.0.0.0
export DAGSTER_POSTGRES_PORT=5432
export DAGSTER_POSTGRES_USER=dagster
export DAGSTER_POSTGRES_PASSWORD=myswankydagsterpassword
