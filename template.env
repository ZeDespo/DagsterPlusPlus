# Docker General settings
SIP_IMAGE=nexus.eigen.live/scb-sip
SIP_VERSION=2.0.0

DAGSTER_HOME=/opt/dagster/sip
DAGSTER_FILESYSTEM_MOUNT=/opt/filesystem_mount

# Postgres configuration
DAGSTER_POSTGRES_HOST=postgres-sip
DAGSTER_POSTGRES_PORT=5432
DAGSTER_POSTGRES_USER=dagster
DAGSTER_POSTGRES_PASSWORD=myswankydagsterpassword
DAGSTER_POSTGRES_NAME=dagster

# Dagster Webserver
DAGSTER_WEBSERVER_PORT=3001

# Redis Configuration 
DAGSTER_REDIS_HOST=redis-sip
DAGSTER_REDIS_PORT=6379
DAGSTER_REDIS_DB=8

# AWS 
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Eigen resource 
EIGEN_DOMAIN=172.16.32.1
EIGEN_USERNAME=
EIGEN_PASSWORD=

# Sirion Resource
SIRION_DOMAIN=
SIRION_OAUTH_KEY=
SIRION_OAUTH_SECRET=

# Azure Queue Resource
AZURE_QUEUE_NAMESPACE=
AZURE_QUEUE_NAME=
AZURE_QUEUE_CONSUMER_NAME=
AZURE_QUEUE_ACCESS_KEY_CODE=

# S3 resource 
S3_ROOT_BUCKET_NAME=
S3_DEFAULT_PREFIX=
S3_MINIO_URL=

# Sharepoint Resource 
SHAREPOINT_API_BASE="graph.microsoft.com/v1.0"
SHAREPOINT_DOMAIN=
SHAREPOINT_SITE_ID=
SHAREPOINT_TENANT_ID=
SHAREPOINT_CLIENT_ID=
SHAREPOINT_CLIENT_SECRET=
SHAREPOINT_SITE_BASE=""

# Tesseract Resource
# Per pdf2image docs: Using multiple threads can give you some gains but avoid more than 4 as this will cause i/o bottleneck (even on my NVMe SSD!).
POPPLER_THREAD_COUNT=2
POPPLER_TIMEOUT_SECONDS=300

# LibreOffice Resource
LIBREOFFICE_PATH=/usr/bin/soffice
LIBREOFFICE_TIMEOUT_DURATION=900
